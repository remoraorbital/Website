rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Replace the two emails with the Google accounts of the founders (lowercase).
service cloud.firestore {
  match /databases/{database}/documents {

    function isFounder() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'founder-one@example.com',
          'founder-two@example.com'
        ];
    }

    // Pages, databases and database rows
    match /pages/{pageId} {
      allow read, write: if isFounder();
    }

    // Workspace name
    match /meta/{docId} {
      allow read, write: if isFounder();
    }

    // Who has signed in (names and photos for "edited by" and person fields)
    match /members/{uid} {
      allow read: if isFounder();
      allow write: if isFounder() && request.auth.uid == uid;
    }

    // Each person's private settings, such as favourites
    match /data/users/{uid}/{docId} {
      allow read, write: if isFounder() && request.auth.uid == uid;
    }
  }
}
