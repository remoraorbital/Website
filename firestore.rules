rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Only the shared workspace login (email/password account) can read or write.
service cloud.firestore {
  match /databases/{database}/documents {

    function isWorkspaceLogin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'info@remoraorbital.co.uk';
    }

    // Pages, databases and database rows
    match /pages/{pageId} {
      allow read, write: if isWorkspaceLogin();
    }

    // Workspace name
    match /meta/{docId} {
      allow read, write: if isWorkspaceLogin();
    }

    // Sign-in record used for "edited by" labels
    match /members/{uid} {
      allow read: if isWorkspaceLogin();
      allow write: if isWorkspaceLogin() && request.auth.uid == uid;
    }

    // Per-login settings, such as favourites
    match /data/users/{uid}/{docId} {
      allow read, write: if isWorkspaceLogin() && request.auth.uid == uid;
    }
  }
}
